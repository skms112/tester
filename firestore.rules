rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ملف العضو ومنشوراته في المجتمع: الكل يقرأ، والعضو يكتب ملفه فقط.
    // الإدارة: أعطِ حسابك claim اسمه admin عشان تقدر تزيل أي منشور.
    match /community/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == uid || request.auth.token.admin == true);
    }
    // وصفات العضو الخاصة: ما يقرأها أو يكتبها إلا صاحبها.
    match /data/users/{uid}/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // أي مسار ثاني مقفل.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
